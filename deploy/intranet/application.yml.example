# 将此文件复制为内网服务器上的 /opt/opencollab/config/application.yml，
# 按实际环境替换所有占位值。不要将包含密码和密钥的实际文件提交到 Git。
spring:
  datasource:
    url: jdbc:mysql://mysql.intranet.local:3306/excel_collab?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: collab_user
    password: replace-with-db-password
  redis:
    host: redis.intranet.local
    port: 6379
    password: replace-with-redis-password

jwt:
  secret: replace-with-a-long-random-secret

app:
  allowed-origins: http://opencollab.intranet.local
  upload-dir: /app/uploads

# 二选一或同时保留：聊天面板会在 Ollama 与 Agnes 之间切换。
ai:
  ollama:
    base-url: http://ollama.intranet.local:11434/v1/chat/completions
    api-key: ''
    model: 'qwen2.5:3b'
  agnes:
    base-url: https://apihub.agnes-ai.com/v1/chat/completions
    api-key: ''
    model: agnes-2.0-flash
